# ============================================================
# ClaudePlane Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# These are in addition to the standard Plane .env variables.

# --- LLM Provider Configuration ---
# Provider: "openai", "anthropic", "claude-max", or "gemini"
LLM_PROVIDER=anthropic
# API key for the chosen provider (use "auto" for claude-max)
LLM_API_KEY=
# Model to use (defaults to provider's default if not set)
LLM_MODEL=claude-sonnet-4-6
# Custom base URL for self-hosted endpoints (vLLM, SGLang, Ollama)
# LLM_BASE_URL=http://your-dgx:8000/v1

# --- AI Rate Limiting ---
# Format: "<count>/<period>" (e.g., "30/minute", "100/hour")
AI_RATE_LIMIT=30/minute
AI_BURST_LIMIT=5/minute

# --- GitHub Reverse Sync ---
# Personal access token with repo scope
# GITHUB_SYNC_TOKEN=ghp_xxxxxxxxxxxx
# Target repository for issue sync (format: "owner/repo")
# GITHUB_SYNC_REPO=oogleyskr/ClaudePlane

# --- Discord Notifications ---
# Discord webhook URL for posting Plane events
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- Webhook Rate Limiting ---
WEBHOOK_RATE_LIMIT=60/minute
